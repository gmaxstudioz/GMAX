# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Better Auth Configuration
BETTER_AUTH_SECRET="generate-a-secure-random-string"
BETTER_AUTH_URL="https://your-admin-domain.com"
NEXT_PUBLIC_AUTH_URL="https://your-admin-domain.com"
NEXT_PUBLIC_API_URL="https://your-api-domain.com/api"

# Public App Configuration (Used for generating client links)
NEXT_PUBLIC_APP_URL="https://your-public-domain.com"

# Termii Configuration for SMS/Email
TERMII_BASE_URL="https://v3.api.termii.com"
TERMII_API_KEY="your-termii-api-key"
TERMII_SECRETE_KEY="your-termii-secret-key"
TERMII_SMS_SENDER_ID="GMAX Studio"
TERMII_EMAIL_CONFIG_ID="your-email-config-id"
TERMII_INVITE_TEMPLATE_ID="template-id"
TERMII_RESET_TEMPLATE_ID="template-id"
TERMII_BOOKING_DELIVERY_TEMPLATE_ID="template-id"
TERMII_WHATSAPP_SENDER_ID=""

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Cloudflare R2 Storage
R2_PUBLIC_URL="pub-xyz.r2.dev"
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-xyz.r2.dev"
R2_BUCKET_NAME="your-bucket-name"
R2_API_KEY="https://abc.r2.cloudflarestorage.com/your-bucket-name"
R2_ENDPOINT_URL="https://abc.r2.cloudflarestorage.com"
R2_ACCESS_KEY="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
