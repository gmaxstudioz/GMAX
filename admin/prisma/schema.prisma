// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  bookings      Booking[]    @relation("BookingCreator")
  payments      Payment[]
  photos        Photo[]
  approvedPhotos Photo[] @relation("PhotoApprovals")

  role                String   @default("user") // "user" | "admin"
  phoneNumber         String?
  phoneNumberVerified Boolean?

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Studio Section

model Studio {
  id             String          @id @default(uuid())
  name           String
  slug           String
  logo           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  metadata       Json?
  members        Member[]
  invitations    Invitation[]
  categories     Category[]
  studioSessions StudioSession[]
  clients        Client[]
  bookings       Booking[]
  roles          Role[]
  courses        Course[]
  enrollments    Enrollment[]
  bookingIntents BookingIntent[]

  @@unique([slug])
  @@map("studio")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  organization   Studio   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  permission     String  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, role])
  @@index([organizationId])
  @@map("organizationRole")
}

model StudioSession {
  id        String    @id @default(cuid())
  name      String
  duration  Int       @default(45)
  studioId  String    @map("studioId")
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  services  Service[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([studioId])
  @@map("studioSession")
}

model Member {
  id       String @id
  studioId String @map("studioId")
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role    String

  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@index([studioId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id        String   @id
  studioId  String   @map("studioId")
  studio    Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  email     String
  role      String?
  status    String   @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  inviterId String
  user      User     @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([email])
  @@map("invitation")
}

// ==================== SERVICE DOMAIN ====================

enum LocationType {
  STUDIO
  OUTDOOR
  BOTH // e.g. All-in-One (studio + 1 outdoor)
  MULTIPLE // e.g. wedding packages
}

enum CourseLevel {
  FOUNDATION // 9–10 weeks
  INTERMEDIATE // 24 weeks
  ADVANCED // 30–32 weeks
  MASTER_CLASS // 3–4 weeks
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  DROPPED
}

model Category {
  id        String    @id @default(uuid())
  name      String
  type      String
  services  Service[]
  studioId  String    @map("studioId")
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([studioId])
  @@map("category")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  features    String[]
  isAddon     Boolean  @default(false)
  isActive    Boolean  @default(true)

  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  studioSessionId String
  studioSession   StudioSession @relation(fields: [studioSessionId], references: [id], onDelete: Cascade)

  variants      ServiceVariant[]
  bookings      Booking[]
  addonBookings Booking[]        @relation("BookingAddons")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("service")
}

model ServiceVariant {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  locationType        LocationType
  basePrice           Decimal      @db.Decimal(12, 2)
  maxPrice            Decimal?     @db.Decimal(12, 2)
  sessionDurationMins Int
  logisticsIncluded   Boolean      @default(true)

  deliverables ServiceDeliverable[]
  bookings     Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, locationType])
  @@index([serviceId])
  @@map("service_variant")
}

model ServiceDeliverable {
  id        String         @id @default(cuid())
  variantId String
  variant   ServiceVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  label    String // "Edited photos", "Highlight video", "Canvas frame"
  quantity Int? // 5, 10, 100
  detail   String? // "professionally retouched", "2–3 min cinematic"
  isFree   Boolean @default(false) // e.g. "5 unedited (free)"

  @@index([variantId])
  @@map("service_deliverable")
}

// ─── TRAINING DOMAIN ───────────────────────────────

model Course {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  name           String
  level          CourseLevel
  price          Decimal     @db.Decimal(12, 2)
  durationWeeks  Int
  isNegotiable   Boolean     @default(false)
  hasCertificate Boolean     @default(false)

  modules     CourseModule[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("course")
}

model CourseModule {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title String
  order Int

  @@index([courseId])
  @@map("course_module")
}

model Enrollment {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  startDate     DateTime
  endDate       DateTime?
  status        EnrollmentStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@index([courseId])
  @@index([clientId])
  @@map("enrollment")
}

model Client {
  id       String    @id @default(uuid())
  name     String
  phone    String
  altPhone String?
  email    String?
  address  String?
  image    String?
  notes    String?   @db.Text
  type     String
  bookings Booking[]

  studioId    String       @map("studioId")
  studio      Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]

  @@unique([studioId, phone])
  @@unique([studioId, email])
  @@index([studioId])
  @@map("client")
}

enum PaymentPlan {
  QUARTER // 25%
  HALF // 50%
  FULL // 100%
}

enum BookingIntentStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

model BookingIntent {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  // Client info — held temporarily, not yet in DB
  clientName       String
  clientEmail      String?
  clientPhone      String?
  existingClientId String? // if returning client

  // Service info
  serviceId    String
  addonIds     String[]
  sessionCount Int
  bookingDate  DateTime
  notes        String?

  // Payment
  paystackReference String  @unique
  amount            Decimal @db.Decimal(12, 2)

  status    BookingIntentStatus @default(PENDING)
  expiresAt DateTime // e.g. 1 hour from creation

  // Set after webhook confirms
  resolvedBookingId String?

  createdAt DateTime @default(now())

  @@index([paystackReference])
  @@index([status])
  @@map("booking_intent")
}

model Booking {
  id String @id @default(uuid())

  bookingDate  DateTime
  sessionCount Int      @default(1)
  notes        String?  @db.Text

  totalAmount Decimal     @db.Decimal(12, 2)
  paymentPlan PaymentPlan @default(FULL)

  bookingStatus  BookingStatus  @default(PENDING)
  paymentStatus  PaymentStatus  @default(PENDING)
  deliveryStatus DeliveryStatus @default(PENDING)

  payments Payment[]
  photos   Photo[]
  addons   Service[] @relation("BookingAddons")

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  studioId  String
  studio    Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy String
  creator   User    @relation("BookingCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  memberId  String?
  member    Member? @relation(fields: [memberId], references: [id])

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  serviceVariant   ServiceVariant? @relation(fields: [serviceVariantId], references: [id])
  serviceVariantId String?

  accessCode       String?         @unique

  notifications Notification[]

  @@index([studioId])
  @@index([clientId])
  @@index([accessCode])
  @@map("booking")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  CANCELLED
}

enum PaymentInstallmentType {
  DEPOSIT // 25% upfront — secures the booking
  INSTALLMENT // mid-sequence partial payment
  BALANCE // final clearing payment
  FULL // paid everything in one transaction
}

model Payment {
  id String @id @default(uuid())

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // ✅ Make Installment/Booking data optional
  installmentType PaymentInstallmentType?
  sequence        Int?
  expectedAmount  Decimal?                @db.Decimal(12, 2)
  amount          Decimal                 @db.Decimal(12, 2)
  method          PaymentMethod           @default(CASH)
  status          PaymentStatus           @default(PENDING)

  paystackReference String? @unique
  paystackResponse  Json?
  receiptNumber     String  @unique
  receiptUrl        String?

  productAccess ProductAccess? @relation("ProductAccessPayment")

  recordedById String?
  recordedBy   User?   @relation(fields: [recordedById], references: [id])

  paymentDate DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([bookingId, sequence])
  @@index([bookingId])
  @@index([status])
  @@index([paymentDate])
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
}

enum PhotoApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Photo {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // R2 Storage
  r2Key        String
  fileName     String
  fileSize     Int
  mimeType     String
  thumbnailKey String?

  uploadedAt DateTime @default(now())
  expiresAt  DateTime // 30 days from upload

  downloaded    Boolean   @default(false)
  downloadedAt  DateTime?
  downloadCount Int       @default(0)

  // Approval workflow
  approvalStatus  PhotoApprovalStatus @default(PENDING_REVIEW)
  rejectionReason String?
  approvedAt      DateTime?
  approvedById String?
  approvedBy   User?   @relation("PhotoApprovals", fields: [approvedById], references: [id])

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([expiresAt])
  @@index([approvalStatus])
}

model Notification {
  id String @id @default(cuid())

  clientPhone String
  clientEmail String?
  clientName  String

  type    NotificationType
  message String                @db.Text
  channel NotificationChannel[]

  status       NotificationStatus @default(PENDING)
  sentAt       DateTime?
  deliveredAt  DateTime?
  errorMessage String?            @db.Text

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([status])
  @@index([bookingId])
  @@index([sentAt])
}

enum NotificationType {
  BOOKING_CONFIRMATION
  PAYMENT_REMINDER
  PHOTOS_READY
  PHOTOS_EXPIRING
  STAFF_INVITATION
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model ProductCategory {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_category")
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  price       Decimal  @db.Decimal(12, 2)
  salePrice   Decimal? @db.Decimal(12, 2)

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  r2Key        String?
  fileName     String?
  fileSize     Int?
  mimeType     String?
  thumbnailKey String?

  isPublished Boolean         @default(false)
  purchases   ProductAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("product")
}

model Buyer {
  id    String @id @default(cuid())
  name  String
  phone String @unique
  email String @unique

  purchases    ProductAccess[]
  accessTokens BuyerAccessToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("buyer")
}

model BuyerAccessToken {
  id String @id @default(cuid())

  buyerId String
  buyer   Buyer  @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([buyerId])
  @@index([token])
  @@map("buyer_access_token")
}

model ProductAccess {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   Buyer  @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  paymentId String?  @unique
  payment   Payment? @relation("ProductAccessPayment", fields: [paymentId], references: [id])

  downloadCount  Int       @default(0)
  lastDownloadAt DateTime?
  expiresAt      DateTime?

  grantedAt DateTime @default(now())

  @@unique([productId, buyerId])
  @@index([buyerId])
  @@index([productId])
  @@map("product_access")
}

model PortfolioItem {
  id       String  @id @default(cuid())
  title    String?
  category String  @default("General")

  r2Key        String
  fileName     String
  fileSize     Int
  mimeType     String
  thumbnailKey String?

  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([sortOrder])
  @@map("portfolio_item")
}